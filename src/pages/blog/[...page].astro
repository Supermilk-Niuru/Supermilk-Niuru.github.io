---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator, PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, getUniqueTagsWithCount, sortMDByDate } from 'astro-pure/server'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const collections = sortMDByDate(await getBlogCollection())
  const uniqueTags = getUniqueTagsWithCount(collections).map(([tag]) => tag)
  const uniqueCategories = [...new Set(collections.map(p => p.data.category).filter(Boolean))] as string[]
  const collectionsCount = collections.length
  return paginate(collections, {
    pageSize: config.content.blogPageSize,
    props: { uniqueTags, uniqueCategories, collectionsCount }
  })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
  uniqueTags: string[]
  uniqueCategories: string[]
  collectionsCount: number
}

const { page, uniqueTags, uniqueCategories, collectionsCount } = Astro.props

const meta = {
  description: '文章列表',
  title: '博客'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← 上一页`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `下一页 →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <Button title='返回首页' href='/' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 mt-6 text-3xl font-medium sm:mt-10'>博客</h1>
    </div>
    {
      page.data.length === 0 ? (
        <p>暂无文章。</p>
      ) : (
        <div class='grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
          <section aria-label='博客文章列表' class='animate' id='content'>
            <div class='mb-3 flex flex-col justify-between text-sm sm:mb-5 sm:flex-row'>
              <span class='text-muted-foreground'>
                第 {page.currentPage} 页 - 显示 {page.data.length} / {collectionsCount} 篇文章
              </span>
              <a aria-label='按年份查看全部文章' href='/archives' data-astro-prefetch>
                按年份查看全部 →
              </a>
            </div>
            <div class='flex flex-col gap-y-4 text-start'>
              {page.data.map((post) => (
                <div class='relative'>
                  {post.data.category && (
                    <span class='absolute -top-1 right-4 z-10 inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary backdrop-blur-sm'>
                      {post.data.category}
                    </span>
                  )}
                  <PostPreview {post} detailed />
                </div>
              ))}
            </div>
            <Paginator {...paginationProps} />
          </section>

          {!!uniqueTags.length && (
            <aside class='animate' id='sidebar'>
              {!!uniqueCategories.length && (
                <div class='mb-8'>
                  <h2 class='mb-4 flex items-center text-lg font-medium'>
                    <Icon name='folder' class='me-2' />
                    分类
                  </h2>
                  <ul class='text-bgColor flex flex-wrap gap-2'>
                    {uniqueCategories.map((cat) => (
                      <li>
                        <Button title={cat} variant='pill' />
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              <h2 class='mb-4 flex items-center text-lg font-medium'>
                <Icon name='tag-2' class='me-2' />
                标签
              </h2>
              <ul class='text-bgColor flex flex-wrap gap-2'>
                {uniqueTags.slice(0, 50).map((tag) => (
                  <li>
                    <Button title={tag} href={`/tags/${tag}`} variant='pill' />
                  </li>
                ))}
              </ul>
              <span class='mt-4 block sm:text-end'>
                <a aria-label='查看全部分类' href='/tags' data-astro-prefetch>
                  查看全部 →
                </a>
              </span>
            </aside>
          )}
        </div>
      )
    }
  </main>
</PageLayout>
