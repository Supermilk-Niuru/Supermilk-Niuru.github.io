---
import { getBlogCollection, getUniqueTags } from 'astro-pure/server'
import { Button, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const allPosts = await getBlogCollection()
const tags = getUniqueTags(allPosts)

const meta = {
  description: 'Browse blog posts by tags',
  title: 'Tags'
}
---

<PageLayout {meta}>
  <Button title='Back to Blog' href='/en/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>All Tags</h1>
    </div>

    <div id='content' class='animate'>
      {tags.length > 0 ? (
        <div class='flex flex-wrap gap-3'>
          {tags.map((tag) => (
            <Label title={tag} as='a' href={`/en/tags/${tag}`} />
          ))}
        </div>
      ) : (
        <p class='text-muted-foreground'>No tags yet.</p>
      )}
    </div>
  </main>
</PageLayout>
