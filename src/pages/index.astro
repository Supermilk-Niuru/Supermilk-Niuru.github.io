---
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import ContributionGrid from '@/components/home/ContributionGrid.astro'
import config from '@/site-config'

const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts)

// Calculate days from first post to now
const firstPostDate = allPostsByDate.length > 0 ? allPostsByDate[allPostsByDate.length - 1].data.publishDate : new Date()
const daysSinceFirstPost = Math.floor((Date.now() - firstPostDate.getTime()) / (1000 * 60 * 60 * 24))

// Last updated date
const lastPost = allPostsByDate.length > 0 ? allPostsByDate[0] : null
const lastUpdatedStr = lastPost
  ? `${lastPost.data.publishDate.getFullYear()}-${String(lastPost.data.publishDate.getMonth() + 1).padStart(2, '0')}-${String(lastPost.data.publishDate.getDate()).padStart(2, '0')}`
  : '-'

const imagePath = config.logo.src
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<PageLayout meta={{ title: config.title }} highlightColor='#659EB9'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <Image
        src={images[imagePath]()}
        alt={config.logo.alt || '头像'}
        class='h-28 w-auto rounded-full border p-1'
        loading='eager'
        fetchpriority='high'
      />

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-medium'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='中国'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='GitHub'
            as='a'
            href='https://github.com/Supermilk-Niuru'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>学生 @CCNU</p>
        <p class='text-muted-foreground'>
          {config.description}
        </p>
        <Button title='More about' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      <Section title='Education'>
        <Card
          as='a'
          heading='华中师范大学'
          subheading='计算机类，本科'
          date='2025年9月 - 至今'
          href='https://cs.ccnu.edu.cn/'
        />
      </Section>

      <Section title='Stastics'>
        <div class='grid grid-cols-2 gap-4 sm:grid-cols-4'>
          <div class='flex flex-col items-center rounded-lg border bg-card p-4 text-center'>
            <span class='text-2xl font-bold text-primary'>{daysSinceFirstPost}</span>
            <span class='text-sm text-muted-foreground'>在线天数</span>
          </div>
          <div class='flex flex-col items-center rounded-lg border bg-card p-4 text-center'>
            <span class='text-2xl font-bold text-primary'>{lastUpdatedStr}</span>
            <span class='text-sm text-muted-foreground'>最后更新</span>
          </div>
          <div class='flex flex-col items-center rounded-lg border bg-card p-4 text-center'>
            <span class='text-2xl font-bold text-primary'>
              {allPosts.reduce((acc, p) => acc + (p.body ? p.body.length : 0), 0) > 10000
                ? Math.floor(allPosts.reduce((acc, p) => acc + (p.body ? p.body.length : 0), 0) / 10000) + 'w+'
                : allPosts.reduce((acc, p) => acc + (p.body ? p.body.length : 0), 0) + '+'}
            </span>
            <span class='text-sm text-muted-foreground'>总字数</span>
          </div>
          <div class='flex flex-col items-center rounded-lg border bg-card p-4 text-center'>
            <span class='text-2xl font-bold text-primary'>{allPosts.length}</span>
            <span class='text-sm text-muted-foreground'>文章总数</span>
          </div>
        </div>
        <div class='mt-4'>
          <ContributionGrid posts={allPosts} />
        </div>
      </Section>
    </div>
    <Quote class='mt-12' />
  </main>
</PageLayout>
