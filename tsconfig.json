{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "paths": {
      "@/*": ["./components/*"]
    }
  },
  "include": [
    "components/**/*",
    "layouts/**/*",
    "pages/**/*",
    "*.ts"
  ]
}
