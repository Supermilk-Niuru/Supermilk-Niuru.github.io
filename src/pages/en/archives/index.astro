---
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate, groupCollectionsByYear } from 'astro-pure/server'
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts)
const allPostsByYear = groupCollectionsByYear(allPostsByDate)
const totalPosts = allPosts.length

const meta = {
  description: 'Browse all blog posts by year',
  title: 'Archives'
}
---

<PageLayout {meta}>
  <Button title='Back to Blog' href='/en/blog' variant='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-2 text-3xl font-medium'>Archives</h1>
      <p class='text-muted-foreground'>{totalPosts} posts</p>
    </div>

    <div id='content' class='animate mt-10 flex flex-col gap-10'>
      {allPostsByYear.length > 0 ? (
        allPostsByYear.map(([year, posts]) => (
          <section>
            <h2 class='mb-4 text-2xl font-medium'>{year}</h2>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {posts.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
          </section>
        ))
      ) : (
        <p class='text-muted-foreground'>No posts yet.</p>
      )}
    </div>
  </main>
</PageLayout>
